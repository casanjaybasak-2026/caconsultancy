---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getServices, getFaqs, getArticles, getSiteConfig } from '../lib/content';
import { orgJsonLd, websiteJsonLd, personJsonLd, faqJsonLd } from '../lib/seo';
import { MONITORS } from '../data/monitors';
import { SITE } from '../config/site';

const [services, faqs, articles, cfg] = await Promise.all([getServices(), getFaqs(), getArticles(), getSiteConfig()]);
const pillars = [
  ['shield', 'Professional expertise', 'Advisory grounded in current income tax, GST and regulatory practice.'],
  ['chart', 'Practical financial analysis', 'Numbers explained in plain terms, tied to decisions you actually need to make.'],
  ['grid', 'Technology-enabled', 'Excel models, dashboards and digital workflows that save you time.'],
  ['users', 'Client-focused', 'Direct communication with the CA and documentation you can rely on.'],
];
const steps = [
  ['calendar', 'Book', 'Choose a service and preferred time on the appointment page.'],
  ['card', 'Pay securely', `Pay the ₹${SITE.feeRupees.toLocaleString('en-IN')} consultation fee via Razorpay — UPI, card or net banking.`],
  ['check', 'Confirm', 'Your slot is confirmed by email or WhatsApp within one working day.'],
  ['video', 'Consult', 'Meet on Google Meet, phone or in person and get practical next steps.'],
];
const audiences = ['Salaried individuals', 'Professionals', 'MSMEs', 'Startups', 'Traders', 'Companies'];
---
<Base
  title="Chartered Accountant in Kolkata | Tax, GST & Business Advisory | CA S K Basak"
  description="CA S K Basak, Chartered Accountant in Kolkata: income tax, GST, audit, accounting, loan/CMA and business advisory for individuals and MSMEs. Book a ₹1,000 consultation online."
  path="/"
  jsonLd={[orgJsonLd(cfg, services), websiteJsonLd(), personJsonLd(), faqJsonLd(faqs)]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_60%_at_85%_10%,rgba(169,129,47,0.14),transparent_60%),radial-gradient(50%_50%_at_0%_100%,rgba(29,78,122,0.08),transparent_60%)]" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[1.25fr_1fr]">
      <div>
        <p class="eyebrow mb-5">Chartered Accountant · ICAI · Kolkata</p>
        <h1 class="text-[2.6rem] leading-[1.05] sm:text-6xl">Clear financial advice, <em class="font-normal text-gold-ink">grounded in your numbers.</em></h1>
        <p class="mt-6 max-w-xl text-lg">Practical tax, GST, accounting, audit and business advisory for individuals, professionals and MSMEs — from a Chartered Accountant who reviews your actual position before advising.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/appointment" class="btn-primary">Book a consultation <Icon name="arrow" size={18} /></a>
          <a href="/services" class="btn-ghost">Explore services</a>
        </div>
        <ul class="mt-10 grid max-w-lg grid-cols-2 gap-x-6 gap-y-3 text-sm sm:grid-cols-3">
          {audiences.map((a) => <li class="flex items-center gap-2"><Icon name="check" size={16} class="text-success" />{a}</li>)}
        </ul>
      </div>
      <aside class="card relative p-7 shadow-xl shadow-navy/5 sm:p-8" aria-labelledby="book-card">
        <p class="eyebrow">One-to-one consultation</p>
        <h2 id="book-card" class="mt-3 text-2xl">Speak directly with the CA</h2>
        <p class="mt-4 flex items-baseline gap-2"><span class="font-display text-5xl font-semibold text-navy-deep">₹1,000</span><span class="text-sm">incl. GST</span></p>
        <ul class="mt-6 space-y-3 text-[15px]">
          <li class="flex gap-3"><Icon name="lock" size={18} class="mt-0.5 text-gold-ink" />Secure payment via Razorpay (UPI, cards, net banking)</li>
          <li class="flex gap-3"><Icon name="clock" size={18} class="mt-0.5 text-gold-ink" />Slot confirmed within one working day</li>
          <li class="flex gap-3"><Icon name="video" size={18} class="mt-0.5 text-gold-ink" />Google Meet, phone or in person</li>
          <li class="flex gap-3"><Icon name="mail" size={18} class="mt-0.5 text-gold-ink" />Instant email receipt with booking reference</li>
        </ul>
        <a href="/appointment" class="btn-gold mt-7 w-full">Book &amp; pay now</a>
      </aside>
    </div>
  </section>

  <!-- Intro / answer block -->
  <section class="border-y border-line bg-white">
    <div class="container-x grid gap-10 py-14 lg:grid-cols-[1fr_2fr]">
      <h2 class="text-3xl">A practical approach to financial advisory</h2>
      <div class="space-y-4 text-[17px]">
        <p><strong class="text-navy-deep">CA S K Basak</strong> is a Chartered Accountant (member of ICAI) based in Kolkata, West Bengal, providing income tax, GST, audit, accounting, loan and project advisory, and business consulting to clients across India. Most engagements can be handled remotely.</p>
        <p>Every engagement starts with a clear review of your actual financial position, so the advice you receive is grounded in your specific facts — not generic templates.</p>
        <a href="/about" class="inline-flex items-center gap-1.5 font-semibold">Read the full profile <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container-x">
      <div class="mb-12 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div><p class="eyebrow mb-3">What we do</p><h2 class="text-3xl sm:text-4xl">Key services</h2></div>
        <a href="/services" class="inline-flex items-center gap-1.5 font-semibold">View all services <Icon name="arrow" size={16} /></a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s, i) => <ServiceCard service={s} index={i} />)}
      </div>
    </div>
  </section>

  <!-- How booking works -->
  <section class="section bg-paper-dim">
    <div class="container-x">
      <p class="eyebrow mb-3">How it works</p>
      <h2 class="max-w-xl text-3xl sm:text-4xl">From booking to advice in four steps</h2>
      <ol class="mt-12 grid gap-5 md:grid-cols-4">
        {steps.map(([icon, t, d], i) => (
          <li class="card relative p-6">
            <span class="grid size-11 place-items-center rounded-full bg-navy text-paper"><Icon name={icon} size={20} /></span>
            <p class="mt-5 text-sm font-semibold text-gold-ink">Step {i + 1}</p>
            <h3 class="mt-1 text-xl">{t}</h3>
            <p class="mt-2 text-[15px]">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Pillars -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr]">
      <div><p class="eyebrow mb-3">Why choose CA S K Basak</p><h2 class="text-3xl sm:text-4xl">Four pillars of the practice</h2></div>
      <div class="grid gap-8 sm:grid-cols-2">
        {pillars.map(([icon, t, d]) => (
          <div class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-gold/30 bg-gold/10 text-gold-ink"><Icon name={icon} size={20} /></span>
            <div><h3 class="text-lg">{t}</h3><p class="mt-1 text-[15px]">{d}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Monitoring tools -->
  <section class="section bg-navy-deep text-paper/80">
    <div class="container-x">
      <p class="eyebrow mb-3 !text-gold-soft">Monthly monitoring tools</p>
      <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
        <h2 class="max-w-2xl text-3xl text-paper sm:text-4xl">Know your numbers every month, not just at year-end</h2>
        <p class="max-w-md">Online dashboards for MSMEs with automated reports and optional CA review — plans from ₹399/month.</p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {MONITORS.map((m) => (
          <a href={`/${m.slug}`} class="group rounded-2xl border border-paper/10 bg-paper/[0.03] p-6 no-underline transition hover:border-gold-soft/50 hover:bg-paper/[0.06]">
            <h3 class="text-xl text-paper">{m.nav}</h3>
            <p class="mt-2 text-sm text-paper/70">{m.lead}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-gold-soft">See plans <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Articles -->
  <section class="section">
    <div class="container-x">
      <div class="mb-12 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div><p class="eyebrow mb-3">Resources</p><h2 class="text-3xl sm:text-4xl">Practical guides on tax, GST and business finance</h2></div>
        <a href="/resources" class="inline-flex items-center gap-1.5 font-semibold">All articles <Icon name="arrow" size={16} /></a>
      </div>
      <div class="grid gap-5 md:grid-cols-3">{articles.slice(0, 3).map((a) => <ArticleCard article={a} />)}</div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-paper-dim">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <div><p class="eyebrow mb-3">Frequently asked</p><h2 class="text-3xl sm:text-4xl">Common questions</h2></div>
      <FaqList faqs={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>
