{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caconsultancyservice",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-30",
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "skb-bookings", "database_id": "6fa77f66-a88d-4274-89ed-0f6274c78db8", "migrations_dir": "migrations" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/manage",
      "/manage/*",
      "/admin",
      "/admin/*",
      "/business-financial-health-monitor/*",
      "/loan-dscr-monitor/*",
      "/cash-flow-monitor/*",
      "/receivable-payable-monitor/*",
      "/cma-bank-renewal-monitor/*",
      "/monthly-mis-cfo-dashboard/*"
    ]
  },
  // Plain (non-secret) settings. Secrets are set with `wrangler secret put` or in the dashboard:
  // RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, RESEND_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID,
  // OWNER_EMAIL (optional: CALLMEBOT_API_KEY, OWNER_WHATSAPP) (kept out of this public repo for privacy)
  "vars": {
    "RAZORPAY_KEY_ID": "rzp_live_U47FOaPBYAbMUq",
    "BOOKING_FROM_EMAIL": "booking@ca-sk-basak-consultancy.in",
    "CONSULTATION_FEE_PAISE": "100000",
    "SITE_URL": "https://ca-sk-basak-consultancy.in",
    "ACCESS_TEAM_DOMAIN": "proud-base-a161.cloudflareaccess.com",
    "ACCESS_AUD": "1cdeeb0bd0b186b8e83ff310398ebcf276c67ce17abe20c84e54fd27c6150e6c"
  }
}
