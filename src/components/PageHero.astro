---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { eyebrow: string; title: string; lead?: string; crumbs?: [string, string][] }
const { eyebrow, title, lead, crumbs } = Astro.props;
---
<section class="relative overflow-hidden border-b border-line bg-paper-dim">
  <div class="pointer-events-none absolute -right-24 -top-24 size-[420px] rounded-full bg-gold/10 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative py-14 sm:py-20">
    {crumbs && <Breadcrumbs items={crumbs} />}
    <p class="eyebrow mb-4">{eyebrow}</p>
    <h1 class="max-w-3xl text-4xl sm:text-5xl">{title}</h1>
    {lead && <p class="mt-5 max-w-2xl text-lg text-ink-soft">{lead}</p>}
    <slot />
  </div>
</section>
