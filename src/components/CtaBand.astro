---
import { SITE } from '../config/site';
interface Props { title?: string; body?: string }
const { title = 'Need professional financial guidance?', body = "Book a one-to-one consultation. Pay the fee online, and we'll confirm your slot within one working day." } = Astro.props;
---
<section class="container-x py-16 sm:py-20">
  <div class="relative overflow-hidden rounded-3xl bg-navy px-8 py-12 sm:px-14 sm:py-16">
    <div class="pointer-events-none absolute -bottom-32 -right-20 size-96 rounded-full bg-gold/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative grid items-center gap-8 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <h2 class="text-3xl text-paper sm:text-4xl">{title}</h2>
        <p class="mt-4 max-w-xl text-paper/75">{body}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
        <a href="/appointment" class="btn-gold">Book consultation · ₹{SITE.feeRupees.toLocaleString('en-IN')}</a>
        <a href="/contact" class="btn-ghost-light">Send an enquiry</a>
      </div>
    </div>
  </div>
</section>
