---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import { abs, graph } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ads?: boolean;
}
const { title, description, path, jsonLd = [], noindex = false, ogType = 'website', ads = true } = Astro.props;
const canonical = abs(path);
const ogImage = `${SITE.url}/icon-512.png`;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="author" content="CA S K Basak" />
    <meta name="geo.region" content="IN-WB" />
    <meta name="geo.placename" content="Kolkata" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f2545" />
    <meta name="google-site-verification" content={SITE.googleVerification} />

    {jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(graph(jsonLd)).replace(/</g, '\\u003c')} />}

    {!noindex && ads && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>}
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
    <script is:inline define:vars={{ ga: SITE.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ga);
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 btn-primary">Skip to content</a>
    <Header path={path} />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
