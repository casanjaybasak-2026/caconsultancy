---
import Icon from './Icon.astro';
import type { Plan } from '../lib/content';
interface Props { plan: Plan; href: string; featured?: boolean }
const { plan: p, href, featured = false } = Astro.props;
const price = new Intl.NumberFormat('en-IN').format(p.price_inr);
---
<article class:list={['relative flex h-full flex-col rounded-[var(--radius-card)] border p-7', featured ? 'border-navy bg-navy text-paper/85 shadow-xl shadow-navy/15' : 'border-line bg-white']}>
  {featured && <span class="absolute -top-3 left-7 rounded-full bg-gold px-3 py-1 text-xs font-semibold text-navy-deep">Most popular</span>}
  <h3 class:list={['text-xl', featured && 'text-paper']}>{p.name}</h3>
  <p class="mt-4 flex items-baseline gap-1">
    <span class:list={['font-display text-4xl font-semibold', featured ? 'text-paper' : 'text-navy-deep']}>₹{price}</span>
    <span class="text-sm">/month</span>
  </p>
  <ul class="mt-6 flex-1 space-y-2.5 text-[15px]">
    {p.features.map((f) => (
      f.endsWith(':') ? <li class:list={['pt-1 font-semibold', featured ? 'text-paper' : 'text-navy-deep']}>{f}</li> :
      <li class="flex gap-2.5"><Icon name="check" size={18} class={featured ? 'mt-0.5 shrink-0 text-gold-soft' : 'mt-0.5 shrink-0 text-success'} />{f}</li>
    ))}
  </ul>
  <a href={href} class:list={['mt-8 w-full', featured ? 'btn-gold' : 'btn-ghost']}>Choose {p.name}</a>
</article>
