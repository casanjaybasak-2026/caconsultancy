---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | CA S K Basak" description="The page you are looking for could not be found." path="/404" noindex>
  <section class="container-x max-w-xl py-32 text-center">
    <p class="font-display text-sm text-gold-ink">404</p>
    <h1 class="mt-3 text-4xl">Page not found</h1>
    <p class="mt-4">The page you're looking for doesn't exist or may have moved.</p>
    <div class="mt-8 flex justify-center gap-3"><a href="/" class="btn-primary">Back to home</a><a href="/resources" class="btn-ghost">Browse guides</a></div>
  </section>
</Base>
