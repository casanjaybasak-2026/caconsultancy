---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Payment not completed | CA S K Basak" description="Your consultation payment was not completed." path="/booking/failed" noindex ads={false}>
  <section class="container-x max-w-2xl py-20 sm:py-28">
    <div class="card p-8 text-center sm:p-12">
      <span class="mx-auto grid size-16 place-items-center rounded-full bg-danger/10 text-danger"><Icon name="alert" size={30} /></span>
      <h1 class="mt-6 text-3xl sm:text-4xl">Payment not completed</h1>
      <p class="mt-4" data-msg>Your payment did not go through, and no booking has been made. If any amount was debited, it is automatically refunded by your bank within 5–7 working days.</p>
      <p class="mt-3 hidden text-sm" data-verify>We could not confirm your payment on our side yet. If money was deducted, don't pay again — your booking will be confirmed automatically once Razorpay notifies us, or contact us with payment ID <strong class="font-mono" data-pay></strong>.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/appointment" class="btn-primary">Try again</a>
        <a href="/contact" class="btn-ghost">Contact us</a>
      </div>
      <p class="mt-6 text-sm text-muted">Your details are saved in this browser, so you won't need to re-enter them.</p>
    </div>
  </section>
</Base>
<script>
  const q = new URLSearchParams(location.search);
  if (q.get('reason') === 'verify') {
    document.querySelector('[data-verify]')!.classList.remove('hidden');
    document.querySelector('[data-msg]')!.classList.add('hidden');
    document.querySelector('[data-pay]')!.textContent = (q.get('payment') ?? '').replace(/[^\w]/g, '').slice(0, 40);
  }
</script>
